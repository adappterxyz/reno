# Copy to .env.local and fill in. Vite only exposes VITE_*-prefixed vars.
VITE_API_BASE=http://localhost:8787
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_spa_client_id
VITE_AUTH0_AUDIENCE=https://api.renosphere.co
# URL of the Brush WASM/WebGPU training worker (see packages/splat-trainer/README.md).
# Leave blank to disable in-browser training in dev.
VITE_BRUSH_WORKER_URL=
