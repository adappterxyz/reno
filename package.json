{
  "name": "reno",
  "version": "0.0.0",
  "private": true,
  "description": "Reno v2 — Cloudflare-native renovation management app with client-side Gaussian-splat 3D",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "build:web": "pnpm --filter @reno/web build",
    "deploy": "pnpm --filter @reno/web build && pnpm --filter @reno/api run deploy"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd", "browser-tabs-lock"]
  }
}
